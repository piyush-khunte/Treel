# ==============================================================================
# TREEL MOBILITY SOLUTIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Keep all secret credentials in .env (do NOT commit sensitive credentials to Git).
# Services remain safely disabled until valid credentials are provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY
# Obtain from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key for frontend Razorpay checkout modal (if needed in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# 2. AMAZON WEB SERVICES (AWS) SES - TRANSACTIONAL EMAIL
# Obtain from: AWS IAM Console (SES Full Access / SendEmail policy)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=support@treel.in
SES_LEADS_EMAIL=sales@treel.in
# Optional secondary email recipient for TMIP marketing leads
TMIP_LEADS_SECONDARY_EMAIL=

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & BACKEND (CRM & AUTH)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for all server-side database access. Server code does NOT fall back to the
# anon/publishable key (RLS blocks anon; see supabase/migrations/20261125_lockdown_rls.sql).
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. SHIPROCKET LOGISTICS & SHIPPING
# Obtain from: Shiprocket Account Settings (API Users)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
# Required: shared secret for /api/shipping/shiprocket/webhook (set the same value as the
# webhook "Token" in Shiprocket; it is sent in the x-api-key header). Webhook is rejected if unset.
SHIPROCKET_WEBHOOK_TOKEN=

# ------------------------------------------------------------------------------
# 5. TREEL BACK-OFFICE / ADMIN PANEL AUTHENTICATION
# Configure credentials in server environment variables
# ------------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Required. Signs admin session cookies; admin login is disabled when unset.
# Use a long random value, e.g. `openssl rand -base64 48`.
ADMIN_AUTH_SECRET=
# Optional. Supabase Auth users may sign in to the admin panel only if their email is
# listed here (comma-separated) or their app_metadata.role is "admin".
ADMIN_EMAILS=
# Local development only; ignored in production builds.
# ADMIN_BYPASS_AUTH=true

# ------------------------------------------------------------------------------
# 6. SITE URL & TOKEN SIGNING
# ------------------------------------------------------------------------------
# Base URL used for every link in outgoing emails (never taken from request headers).
NEXT_PUBLIC_SITE_URL=https://treel.in
# Signs whitepaper download tokens (falls back to SESSION_SECRET / the Supabase secret key).
WHITEPAPER_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# 7. RATE LIMITING (recommended in production)
# Upstash Redis REST credentials (or Vercel KV: KV_REST_API_URL / KV_REST_API_TOKEN).
# Without them, limits are kept per serverless instance only.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
