# ==============================================================================
# TREEL MOBILITY SOLUTIONS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Keep all secret credentials in .env (do NOT commit sensitive credentials to Git).
# Services remain safely disabled until valid credentials are provided.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY
# Obtain from: https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public key for frontend Razorpay checkout modal (if needed in browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# 2. AMAZON WEB SERVICES (AWS) SES - TRANSACTIONAL EMAIL
# Obtain from: AWS IAM Console (SES Full Access / SendEmail policy)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=support@treel.in
SES_LEADS_EMAIL=sales@treel.in
# Optional secondary email recipient for TMIP marketing leads
TMIP_LEADS_SECONDARY_EMAIL=

# ------------------------------------------------------------------------------
# 3. SUPABASE DATABASE & BACKEND (CRM & AUTH)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 4. SHIPROCKET LOGISTICS & SHIPPING
# Obtain from: Shiprocket Account Settings (API Users)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# ------------------------------------------------------------------------------
# 5. TREEL BACK-OFFICE / ADMIN PANEL AUTHENTICATION
# Configure credentials in server environment variables
# ------------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=
